{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-prod",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/worker.ts",
  "minify": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Only the PDF engine: the Worker serves its build-time brotli copy.
    "run_worker_first": ["/vendor/embedpdf/immutable/*"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examcooker-prod"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "445bc817f6f946bf8e19414649657c58",
      "localConnectionString": "postgresql://examcooker:examcooker@127.0.0.1:5432/examcooker"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examcooker-prod-next-cache"
    },
    {
      "binding": "APP_CACHE_BUCKET",
      "bucket_name": "examcooker-prod-app-cache"
    },
    {
      // Earlier builds' hashed files for tabs that outlive a deploy.
      "binding": "STATIC_ARCHIVE",
      "bucket_name": "examcooker-prod-static-archive"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
        "script_name": "examcooker-prod-tag-cache"
      },
      {
        "name": "APP_STATE",
        "class_name": "AppState",
        "script_name": "examcooker-prod-app-state"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "cache": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "region": "aws:ap-south-1"
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000
  },
  "vars": {
    "PRODUCTION_FULL_CUTOVER": "1"
  },
  // Archives each new version's hashed files once (cloudflare/static-archive.ts).
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "routes": [
    {
      "pattern": "examcooker.acmvit.in",
      "custom_domain": true
    },
    {
      "pattern": "exam-cooker.acmvit.in",
      "custom_domain": true
    }
  ]
}
