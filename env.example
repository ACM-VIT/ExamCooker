# Use a disposable CockroachDB database. Replace this URL for your own instance.
DATABASE_URL=postgresql://root@127.0.0.1:26257/examcooker?sslmode=disable

# Generate a value with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret

# Placeholders let the app start; Google sign-in needs real OAuth credentials.
AUTH_GOOGLE_ID=local-placeholder
AUTH_GOOGLE_SECRET=local-placeholder

NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
