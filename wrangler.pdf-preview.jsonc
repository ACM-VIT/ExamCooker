{
  // Renders first-page previews for examcooker-assets. No public route: the
  // assets Worker reaches it through a service binding.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-pdf-preview",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/pdf-preview-worker.ts",
  "minify": true,
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "examcooker-prod-assets" }],
  "images": { "binding": "IMAGES" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
