    "next": "16.3.0",
    "next-auth": "4.24.15",
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "posthog-js": "^1.411.0",
    "posthog-node": "^5.47.10",
    "postprocessing": "^6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.0.0",
    "react-player": "^3.4.0",
    "redis": "6.2.0",
    "server-only": "0.0.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.185.4",
    "drizzle-kit": "1.0.0-rc.1",
    "postcss": "8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "capacitor-native-tab": {
