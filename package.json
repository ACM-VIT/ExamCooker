{
  "name": "examcooker-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "cli": "node ./packages/cli/dist/cli.js",
    "dev": "node scripts/sync-mcp-ui.mjs && node scripts/sync-pdfium-wasm.js && node scripts/sync-vin-together.js && next dev",
    "build": "node scripts/sync-mcp-ui.mjs && node scripts/sync-pdfium-wasm.js && node scripts/sync-vin-together.js && next build",
    "start": "next start",
    "cf:command-agent:dev": "wrangler dev --config worker/wrangler.jsonc",
    "cf:command-agent:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "cf:command-agent:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "cap:sync": "capacitor sync",
    "cap:copy": "capacitor copy",
    "cap:open:ios": "capacitor open ios",
    "cap:open:android": "capacitor open android",
    "cli:build": "pnpm --filter examcooker build",
    "cli:dev": "pnpm --filter examcooker dev",
    "mcp:test": "tsx --test lib/mcp/*.test.ts",
    "mcp:sync-ui": "node scripts/sync-mcp-ui.mjs",
    "mcp:preview": "tsx scripts/preview-mcp-widget.ts",
    "sync_pdfium_wasm": "node scripts/sync-pdfium-wasm.js",
    "sync_vin_together": "node scripts/sync-vin-together.js",
    "seed_tags": "tsx scripts/seed-tags.js",
    "seed_courses": "tsx scripts/seed-courses.js",
    "seed_courses:dry": "tsx scripts/seed-courses.js --dry-run",
    "backfill_metadata": "tsx scripts/backfill-paper-metadata.js",
    "backfill_metadata:dry": "tsx scripts/backfill-paper-metadata.js --dry-run",
    "backfill_answer_key_links": "tsx scripts/backfill-answer-key-links.ts",
    "backfill_answer_key_links:dry": "tsx scripts/backfill-answer-key-links.ts --dry-run",
    "backfill_content_hashes": "tsx scripts/backfill-content-hashes.ts --apply",
    "backfill_content_hashes:dry": "tsx scripts/backfill-content-hashes.ts",
    "copy_prod_to_dev": "tsx scripts/db/copy-prod-to-dev.js",
    "cf:build": "POSTHOG_SOURCEMAP_UPLOAD=true opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare populateCache local && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --config wrangler.jsonc --config wrangler.tag-cache.local.jsonc --config wrangler.app-state.local.jsonc",
    "cf:tag-cache:deploy": "wrangler deploy --config wrangler.tag-cache.jsonc",
    "cf:deploy": "pnpm cf:tag-cache:deploy && pnpm cf:app-state:deploy && opennextjs-cloudflare deploy",
    "cf:app-state:deploy": "wrangler deploy --config wrangler.app-state.jsonc",
    "cf:build:canary": "NEXT_PUBLIC_BASE_URL=https://examcooker.acmvit.in NEXTAUTH_URL=https://examcooker.acmvit.in AUTH_URL=https://examcooker.acmvit.in POSTHOG_SOURCEMAP_UPLOAD=true opennextjs-cloudflare build --config wrangler.canary.jsonc",
    "cf:upload:canary": "opennextjs-cloudflare upload --config wrangler.canary.jsonc --cacheChunkSize 5",
    "cf:deploy:canary": "opennextjs-cloudflare deploy --config wrangler.canary.jsonc --cacheChunkSize 5",
    "cf:build:prod": "NEXT_PUBLIC_BASE_URL=https://examcooker.acmvit.in NEXTAUTH_URL=https://examcooker.acmvit.in AUTH_URL=https://examcooker.acmvit.in POSTHOG_SOURCEMAP_UPLOAD=true opennextjs-cloudflare build --config wrangler.production.jsonc",
    "cf:deploy:prod": "opennextjs-cloudflare deploy --config wrangler.production.jsonc --cacheChunkSize 5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/core": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opennextjs/cloudflare": "1.20.10",
    "@posthog/react": "^1.11.3",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-toast": "^1.3.0",
    "@redis/entraid": "6.3.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@types/lodash": "^4.17.26",
    "agents": "^0.28.0",
    "ai": "^7.0.137",
    "capacitor-native-tab": "1.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.7",
    "drizzle-orm": "1.0.0-rc.4",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "ogl": "^1.0.11",
    "openai": "7.32.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-cloudflare": "^1.4.1",
    "posthog-js": "^1.438.8",
    "posthog-node": "^5.55.2",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.3",
    "react-player": "^3.4.0",
    "redis": "6.3.0",
    "server-only": "0.0.1",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@posthog/cli": "0.18.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "^21.0.1",
    "postcss": "8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@6.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "capacitor-native-tab": {
      "@capacitor/core": "^8.5.3"
    }
  }
}
