{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-rollout",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/cutover/worker.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "CANARY", "service": "examcooker-canary" }],
  "vars": { "CF_PERCENT": "50" },
  "routes": [{ "pattern": "examcooker.acmvit.in/*", "zone_id": "8e6e67e2f97951b41fa96cdbd40a0f50" }],
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }]
}
