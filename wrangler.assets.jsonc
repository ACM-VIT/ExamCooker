{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-assets",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/assets-worker.ts",
  "minify": true,
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "examcooker-prod-assets" }],
  // Deploy wrangler.pdf-preview.jsonc first; it renders first-page previews.
  "services": [{ "binding": "PDF_PREVIEW", "service": "examcooker-pdf-preview" }],
  // New preview renders per client IP; stored previews are not limited.
  "ratelimits": [{ "name": "PREVIEW_RENDERS", "namespace_id": "6061", "simple": { "limit": 60, "period": 60 } }],
  "routes": [{ "pattern": "ec-assets.acmvit.in", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
