{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-assets",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/assets-worker.ts",
  "minify": true,
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "examcooker-prod-assets" }],
  "routes": [{ "pattern": "ec-assets.acmvit.in", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
