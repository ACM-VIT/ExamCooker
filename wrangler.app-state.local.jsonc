{
  // Local development only: Wrangler cannot infer SQLite storage from a
  // cross-Worker transfer migration. Production uses wrangler.app-state.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-test-app-state",
  "main": "cloudflare/app-state-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "APP_STATE", "class_name": "AppState" }]
  },
  "migrations": [
    { "tag": "v1-local", "new_sqlite_classes": ["AppState"] }
  ]
}
