{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "examcooker-command-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ExamCookerCommandAgent",
        "class_name": "ExamCookerCommandAgent"
      },
      {
        "name": "ExamCookerStudyBrainAgent",
        "class_name": "ExamCookerStudyBrainAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExamCookerCommandAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ExamCookerStudyBrainAgent"]
    }
  ],
  "vars": {
    "OPENAI_COMMAND_MODEL": "gpt-5.4-nano",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small"
  },
  "observability": {
    "enabled": true
  }
}
