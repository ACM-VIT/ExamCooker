{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "examcooker-command-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ExamCookerCommandAgent",
        "class_name": "ExamCookerCommandAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExamCookerCommandAgent"]
    }
  ],
  "vars": {
    "AI_PROVIDER": "openai"
  },
  "observability": {
    "enabled": true
  }
}
