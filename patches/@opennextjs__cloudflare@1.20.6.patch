+        let result;
+        let stage = 0;
+        let hops = 0;
+        let finished = false;
+        const fail = (error) => {
+            if (finished)
+                return;
+            finished = true;
+            releaseRun();
+            reject(error);
+        };
+        const complete = () => {
+            if (finished)
+                return;
+            finished = true;
+            releaseRun();
+            resolve(result);
+        };
+        const schedule = (callback) => {
+            try {
+                hop(callback);
+            }
+            catch (error) {
+                fail(error);
+            }
+        };
