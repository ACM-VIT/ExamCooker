+
+            return windowInsets;
+        });
+
+        nativeTabBar.addOnLayoutChangeListener((view, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom) -> {
+            if (bottom - top != oldBottom - oldTop) {
+                updateWebViewBottomInset();
+            }
+        });
+
+        parent.addView(nativeTabBar);
