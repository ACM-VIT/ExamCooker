+            coordinatorLayoutParams.gravity = Gravity.BOTTOM;
+            layoutParams = coordinatorLayoutParams;
+        } else {
+            FrameLayout.LayoutParams frameLayoutParams = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
