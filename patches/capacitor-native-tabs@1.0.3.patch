+
+            if (!suppressSelectionCallback && index >= 0 && index < tabs.size()) {
+                JSObject payload = new JSObject();
+                payload.put("index", index);
+                payload.put("tab", tabs.get(index));
+                notifyListeners("tabSelected", payload);
+            }
+
+            return true;
+        });
+
+        ViewCompat.setOnApplyWindowInsetsListener(nativeTabBar, (view, windowInsets) -> {
+            Insets systemBarsInsets = windowInsets.getInsets(
+                WindowInsetsCompat.Type.systemBars() | WindowInsetsCompat.Type.displayCutout()
+            );
+            view.setPadding(
+                systemBarsInsets.left,
+                view.getPaddingTop(),
+                systemBarsInsets.right,
+                systemBarsInsets.bottom
+            );
+
+            boolean nextKeyboardVisible = windowInsets.isVisible(WindowInsetsCompat.Type.ime());
+            if (keyboardVisible != nextKeyboardVisible) {
+                keyboardVisible = nextKeyboardVisible;
+                applyTabBarVisibility();
+            } else {
+                updateWebViewBottomInset();
