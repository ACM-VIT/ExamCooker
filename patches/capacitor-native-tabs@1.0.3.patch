+    private void populateMenu() {
+        if (tabBar == null) {
+            return;
+        }
+
+        Menu menu = tabBar.getMenu();
+        menu.clear();
+
+        for (int index = 0; index < tabs.size(); index++) {
+            JSObject tab = tabs.get(index);
+            String title = tab.getString("title", "Tab");
+            menu.add(Menu.NONE, index, Menu.NONE, title).setIcon(resolveIcon(tab, index));
+        }
+    }
+
+    private void selectTabInternal(int index, boolean emitSelection) {
+        if (tabBar == null || tabs.isEmpty()) {
+            selectedIndex = -1;
+            return;
+        }
+
+        int normalizedIndex = normalizeIndex(index, tabs.size());
+        selectedIndex = normalizedIndex;
+
+        if (tabBar.getSelectedItemId() != normalizedIndex) {
+            suppressSelectionCallback = !emitSelection;
+            tabBar.setSelectedItemId(normalizedIndex);
+            suppressSelectionCallback = false;
+        } else if (emitSelection) {
+            JSObject payload = new JSObject();
+            payload.put("index", normalizedIndex);
+            payload.put("tab", tabs.get(normalizedIndex));
+            notifyListeners("tabSelected", payload);
+        }
+
+        updateWebViewBottomInset();
+    }
+
+    private void applyTabBarVisibility() {
+        if (tabBar == null) {
+            return;
+        }
+
+        boolean shouldShow = requestedVisible && !tabs.isEmpty() && !keyboardVisible;
+        tabBar.setVisibility(shouldShow ? View.VISIBLE : View.GONE);
+        updateWebViewBottomInset();
+    }
+
+    private void updateWebViewBottomInset() {
+        if (getBridge() == null || getBridge().getWebView() == null) {
+            return;
+        }
+
+        WebView webView = getBridge().getWebView();
+        ViewGroup.LayoutParams existingLayoutParams = webView.getLayoutParams();
+        if (!(existingLayoutParams instanceof MarginLayoutParams)) {
+            return;
+        }
+
+        MarginLayoutParams marginLayoutParams = (MarginLayoutParams) existingLayoutParams;
+        int targetBottomMargin = tabBar != null && tabBar.getVisibility() == View.VISIBLE ? tabBar.getHeight() : 0;
+        if (marginLayoutParams.bottomMargin == targetBottomMargin) {
+            return;
+        }
+
+        marginLayoutParams.bottomMargin = targetBottomMargin;
+        webView.setLayoutParams(marginLayoutParams);
+        webView.requestLayout();
+    }
+
+    private void applyColorPalette() {
+        if (tabBar != null) {
+            applyColorPalette(tabBar);
+        }
+    }
+
+    private void applyColorPalette(BottomNavigationView nativeTabBar) {
+        boolean dark = isDarkTheme();
+        int background = dark ? Color.parseColor("#09101E") : Color.parseColor("#FFFFFF");
+        int selected = dark ? Color.parseColor("#3BF4C7") : Color.parseColor("#0D5875");
+        int unselected = dark ? Color.parseColor("#8F9BAA") : Color.parseColor("#5F6B7A");
+        int indicator = dark ? Color.parseColor("#15384A") : Color.parseColor("#D6EEF5");
+        int[][] states = new int[][] {
+            new int[] { android.R.attr.state_checked },
+            new int[] {}
+        };
+        int[] colors = new int[] { selected, unselected };
+
+        nativeTabBar.setBackgroundColor(background);
+        nativeTabBar.setItemTextColor(new ColorStateList(states, colors));
+        nativeTabBar.setItemIconTintList(new ColorStateList(states, colors));
+        nativeTabBar.setItemActiveIndicatorColor(ColorStateList.valueOf(indicator));
+    }
+
+    private boolean isDarkTheme() {
+        int nightModeFlags = getContext().getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK;
+        return nightModeFlags == Configuration.UI_MODE_NIGHT_YES;
+    }
+
+    private int normalizeIndex(Integer maybeIndex, int size) {
+        if (size <= 0) {
+            return -1;
+        }
+        if (maybeIndex == null || maybeIndex < 0 || maybeIndex >= size) {
+            return 0;
+        }
+        return maybeIndex;
+    }
+
+    private int resolveIcon(JSObject tab, int index) {
+        int explicitIcon = resolveAppDrawable(tab.getString("androidIcon", ""));
+        if (explicitIcon != 0) {
+            return explicitIcon;
+        }
+
+        String route = tab.getString("route", "").toLowerCase(Locale.US);
+        String title = tab.getString("title", "").toLowerCase(Locale.US);
+
+        if (route.equals("/") || title.contains("home")) {
+            return resolveAppDrawable("ec_tab_home", android.R.drawable.ic_menu_view);
+        }
+        if (route.contains("paper") || title.contains("paper")) {
+            return resolveAppDrawable("ec_tab_papers", android.R.drawable.ic_menu_agenda);
+        }
+        if (route.contains("note") || title.contains("note")) {
+            return resolveAppDrawable("ec_tab_notes", android.R.drawable.ic_menu_edit);
+        }
+        if (route.contains("syllabus") || title.contains("syllabus")) {
+            return resolveAppDrawable("ec_tab_syllabus", android.R.drawable.ic_menu_sort_by_size);
+        }
+        if (route.contains("resource") || title.contains("resource")) {
+            return resolveAppDrawable("ec_tab_resources", android.R.drawable.ic_menu_info_details);
+        }
+
+        return switch (index) {
+            case 0 -> resolveAppDrawable("ec_tab_home", android.R.drawable.ic_menu_view);
+            case 1 -> resolveAppDrawable("ec_tab_papers", android.R.drawable.ic_menu_agenda);
+            case 2 -> resolveAppDrawable("ec_tab_notes", android.R.drawable.ic_menu_edit);
+            case 3 -> resolveAppDrawable("ec_tab_syllabus", android.R.drawable.ic_menu_sort_by_size);
+            default -> resolveAppDrawable("ec_tab_resources", android.R.drawable.ic_menu_info_details);
+        };
+    }
+
+    private int resolveAppDrawable(String resourceName) {
+        return resolveAppDrawable(resourceName, 0);
+    }
+
+    private int resolveAppDrawable(String resourceName, int fallbackResourceId) {
+        if (resourceName == null || resourceName.isEmpty()) {
+            return fallbackResourceId;
+        }
+
+        int resourceId = getContext()
+            .getResources()
+            .getIdentifier(resourceName, "drawable", getContext().getPackageName());
+        return resourceId != 0 ? resourceId : fallbackResourceId;
+    }
+
+    private int dp(int value) {
+        return (int) TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP,
+            value,
+            getContext().getResources().getDisplayMetrics()
+        );
+    }
