+            );
+            frameLayoutParams.gravity = Gravity.BOTTOM;
+            layoutParams = frameLayoutParams;
+        }
+
+        nativeTabBar.setLayoutParams(layoutParams);
+
+        nativeTabBar.setOnItemSelectedListener(item -> {
