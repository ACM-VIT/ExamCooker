{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-canary",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/worker.ts",
  "minify": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examcooker-canary"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "37449c92cf764de4b7c8be5b128c99cd",
      "localConnectionString": "postgresql://examcooker:examcooker@127.0.0.1:5432/examcooker"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examcooker-canary-next-cache"
    },
    {
      "binding": "APP_CACHE_BUCKET",
      "bucket_name": "examcooker-canary-app-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
        "script_name": "examcooker-canary-tag-cache"
      },
      {
        "name": "APP_STATE",
        "class_name": "AppState",
        "script_name": "examcooker-canary-app-state"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": false
  },
  "workers_dev": false,
  "preview_urls": false
}
