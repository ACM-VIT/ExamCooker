{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "examcooker-test",
  "account_id": "4ee36e42cabfd44e8ce61b2a6bd637c5",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "examcooker-test"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "37449c92cf764de4b7c8be5b128c99cd",
      "localConnectionString": "postgresql://examcooker:examcooker@127.0.0.1:5432/examcooker"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "examcooker-test-next-cache"
    },
    {
      "binding": "APP_CACHE_BUCKET",
      "bucket_name": "examcooker-test-app-cache"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
        "script_name": "examcooker-test-tag-cache"
      },
      {
        "name": "APP_STATE",
        "class_name": "AppState",
        "script_name": "examcooker-test-app-state"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DOQueueHandler",
        "DOShardedTagCache"
      ]
    },
    {
      "tag": "v2-app-state",
      "new_sqlite_classes": [
        "AppState"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "ec-test.acmvit.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": false
  }
}
